		{"id":"5B500C98-E7BD-4FCD-B3EC-7B66352DF37C","type":"text","x":580,"y":43963,"width":380,"height":222,"text":"## #错题\n\n1. bisschen\n表示程度轻微，时间不长\n2. gerade:\n正在\n3. ein\n阴中受将\nde eine E-Mail.","ostraconMnUrl":"marginnote4app://note/5B500C98-E7BD-4FCD-B3EC-7B66352DF37C","color":"#FF0000"},
