		{"id":"DF5B7D13-C84C-4C4A-A3CF-3F511D3B67E1","type":"text","x":580,"y":43333,"width":380,"height":186,"text":"## Was its, da\"?\n\nda\n\n![linked excerpt](../assets/0c237c1e7718a297d84aabe6bd6bc163.png)\n\n#错题","ostraconMnUrl":"marginnote4app://note/DF5B7D13-C84C-4C4A-A3CF-3F511D3B67E1","color":"#FFAABE"},
		{"id":"B7051C30-1713-4121-89DF-D1289697151B","type":"text","x":580,"y":43543,"width":380,"height":186,"text":"## 动词位置\n\nich sie\n\n![linked excerpt](../assets/61779be3ed4a6c1c73d4848c1263a3bf.png)\n\n#错题","ostraconMnUrl":"marginnote4app://note/B7051C30-1713-4121-89DF-D1289697151B","color":"#FFAABE"},
