    {
      "type": "text", "id": "macro2_d", "x": 400, "y": 232, "width": 240, "height": 35,
      "text": "设激励漏斗\n补贴谁，惩罚谁", "originalText": "设激励漏斗\n补贴谁，惩罚谁",
