		{
			"type": "text",
			"id": "3ldvRniH",
			"x": 165,
			"y": 1456,
			"width": 210,
			"height": 35,
			"text": "真相 = 观念与事实的符合。\n逻辑学的终点是求真，不是取胜。",
			"originalText": "真相 = 观念与事实的符合。\n逻辑学的终点是求真，不是取胜。",
			"fontSize": 14,
			"fontFamily": 3,
