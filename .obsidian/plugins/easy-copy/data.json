{
  "useFrontmatterAsDisplay": false,
  "frontmatterKey": "title",
  "addToMenu": true,
  "addExtraCommands": true,
  "showNotice": true,
  "useHeadingAsDisplayText": true,
  "headingLinkSeparator": "#",
  "simplifiedHeadingToNoteLink": true,
  "strictHeadingMatch": false,
  "linkFormat": "obsidian",
  "resolveLinkPathOnPaste": true,
  "enableInlineCode": true,
  "enableBold": true,
  "enableHighlight": true,
  "enableItalic": true,
  "enableStrikethrough": true,
  "enableInlineLatex": true,
  "enableLink": true,
  "enableWikiLink": true,
  "matcherOrder": [
    "bold",
    "italic",
    "highlight",
    "strikethrough",
    "inline-code",
    "inline-latex",
    "link",
    "wiki-link"
  ],
  "customMatchers": [],
  "keepWikiBrackets": false,
  "autoEmbedBlockLink": false,
  "enableCalloutCopy": true,
  "calloutCopyPriority": true,
  "codeBlockBehavior": "copy-content",
  "noCopyAction": "block-link",
  "allowManualBlockId": false,
  "blockIdInsertPosition": "end-of-block",
  "autoBlockDisplayText": true,
  "blockDisplayFullBlock": false,
  "blockDisplayWordLimit": 3,
  "blockDisplayCharLimit": 5,
  "enableDisplayNameRegex": false,
  "displayNameRegexFrom": "^#*\\s*[“\"]([^”\"]+)[”\"].*$",
  "displayNameRegexTo": "$1",
  "customizeTargets": false,
  "autoAddBlockId": true
}